# Скопируйте в .env. Не добавляйте реальные секреты в Git.
# Токен нужен только для запуска polling; локальный --check работает без него.
JINX_BOT_TOKEN=
JINX_CHANNEL_ID=-1002819525144
# Необязательные HTTPS-ссылки: заполните только реальными адресами.
JINX_CHANNEL_URL=
JINX_MINI_APP_URL=
JINX_SUPPORT_URL=
JINX_DATABASE_PATH=data/jinx.sqlite3
